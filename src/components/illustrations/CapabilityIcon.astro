---
interface Props { name: 'strategy' | 'pmo' | 'analysis' | 'data' | 'vendor' | 'risk' | 'tools' }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'strategy' && <><path d="M3 20h18" /><path d="M5 16l4-5 4 3 6-8" /><path d="M15 6h4v4" /></>}
  {name === 'pmo' && <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M8 13h3M8 16h6" /><path d="M15 13l1.5 1.5L19 12" /></>}
  {name === 'analysis' && <><circle cx="10.5" cy="10.5" r="6" /><path d="M15 15l5 5M8 10.5h5M10.5 8v5" /></>}
  {name === 'data' && <><ellipse cx="12" cy="5.5" rx="7" ry="2.5" /><path d="M5 5.5v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6" /><path d="M5 11.5v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6" /></>}
  {name === 'vendor' && <><path d="M4 7h16v12H4z" /><path d="M9 7V5h6v2" /><path d="M8.5 13l2.5 2.5 4.5-5" /></>}
  {name === 'risk' && <><path d="M12 3l8 3v5c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z" /><path d="M12 8v5M12 16h.01" /></>}
  {name === 'tools' && <><path d="M14.5 5.5a4 4 0 0 0 4.9 4.9L12 17.8 9.2 15z" /><path d="M9.2 15L4 20.2" /><circle cx="17" cy="7" r="1" /></>}
</svg>
