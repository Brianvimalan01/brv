---
// Line-art scenes for each hobby.
interface Props { name: 'runner' | 'mountain' | 'futsal' }
const { name } = Astro.props;
---
<svg viewBox="0 0 240 160" class="hobby-svg" aria-hidden="true">
  {name === 'runner' && (
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="190" cy="36" r="18" fill="var(--accent-2-soft)" stroke="none" />
      <path d="M10 138 Q 120 118 230 138" stroke="var(--line)" stroke-width="3" />
      <path d="M30 120h40M20 104h30M40 88h20" stroke="var(--accent-2)" stroke-width="3" opacity="0.5" class="draw" pathLength="1" />
      <circle cx="132" cy="38" r="11" fill="var(--accent-2)" stroke="none" />
      <path d="M128 52 L116 88" stroke="var(--ink)" stroke-width="7" />
      <path d="M126 58 L146 70 L160 60" stroke="var(--ink)" stroke-width="5" />
      <path d="M126 58 L104 66 L94 82" stroke="var(--ink)" stroke-width="5" />
      <path d="M116 88 L140 104 L134 130" stroke="var(--ink)" stroke-width="6" />
      <path d="M116 88 L100 110 L78 112" stroke="var(--ink)" stroke-width="6" />
    </g>
  )}
  {name === 'mountain' && (
    <g stroke-linejoin="round">
      <circle cx="186" cy="38" r="16" fill="var(--accent-2-soft)" />
      <path d="M0 140 L70 52 L110 100 L150 40 L240 140 Z" fill="var(--accent-soft)" />
      <path d="M150 40 L136 58 L146 56 L156 66 L164 54 Z" fill="var(--surface)" />
      <path d="M70 52 L60 66 L72 62 L80 64 Z" fill="var(--surface)" />
      <path d="M20 140 C 60 120, 90 132, 120 112 S 170 92, 196 72" fill="none" stroke="var(--accent)" stroke-width="3" stroke-dasharray="2 7" stroke-linecap="round" />
      <path d="M150 40 v-18 l14 6 -14 6" fill="var(--accent-2)" stroke="var(--accent-2)" stroke-width="2" />
      <path d="M0 140 H240" stroke="var(--line)" stroke-width="3" />
    </g>
  )}
  {name === 'futsal' && (
    <g fill="none" stroke-linecap="round">
      <rect x="14" y="20" width="212" height="120" rx="10" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="2.5" />
      <path d="M120 20v120" stroke="var(--accent)" stroke-width="2" />
      <circle cx="120" cy="80" r="22" stroke="var(--accent)" stroke-width="2" />
      <path d="M14 56 h22 a24 24 0 0 1 0 48 h-22 M226 56 h-22 a24 24 0 0 0 0 48 h22" stroke="var(--accent)" stroke-width="2" />
      <circle cx="160" cy="66" r="16" fill="var(--surface)" stroke="var(--ink)" stroke-width="2.5" />
      <path d="M160 58 l7 5 -3 8 h-8 l-3 -8 z" fill="var(--ink)" stroke="none" />
      <path d="M100 100 Q 130 70 140 70" stroke="var(--accent-2)" stroke-width="2.5" stroke-dasharray="3 6" />
    </g>
  )}
</svg>
<style>
  .hobby-svg { width: 100%; display: block; }
</style>
