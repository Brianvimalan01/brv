---
import { url } from '../lib/url';
const links = [
  { href: '/about', label: 'About' },
  { href: '/hobbies', label: 'Hobbies' },
  { href: '/portfolio', label: 'Portfolio' },
];
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
---
<header class="nav">
  <div class="container nav-inner">
    <a href={url('/')} class="brand" aria-label="BRV — Brianvimalan Francis, home">
      <span class="mark">BRV</span>
      <span class="name">Brianvimalan Francis</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={url(l.href)} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li>
          <button id="theme-toggle" type="button" aria-label="Toggle dark mode">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
    const next = isDark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px); border-bottom: 1px solid var(--line);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 12px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); min-width: 0; }
  .mark {
    font: 700 0.95rem/1 var(--font-display); letter-spacing: 0.04em; padding: 8px 9px;
    border-radius: 9px; background: var(--ink); color: var(--bg);
  }
  .name { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  ul { display: flex; align-items: center; gap: 4px; list-style: none; margin: 0; padding: 0; }
  ul a { color: var(--ink-2); text-decoration: none; font-weight: 500; padding: 8px 10px; border-radius: 8px; font-size: 0.95rem; }
  ul a:hover { color: var(--ink); background: var(--surface-2); }
  ul a[aria-current='page'] { color: var(--ink); background: var(--surface-2); }
  button {
    display: grid; place-items: center; width: 36px; height: 36px; border-radius: 8px;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink-2); cursor: pointer;
  }
  @media (max-width: 640px) {
    .name { display: none; }
    ul a { padding: 8px 7px; font-size: 0.9rem; }
  }
</style>
