---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import StatCounters from '../components/illustrations/StatCounters.astro';
import WorkstreamWheel from '../components/illustrations/WorkstreamWheel.astro';
import MigrationLifecycle from '../components/illustrations/MigrationLifecycle.astro';
import IntegrationHub from '../components/illustrations/IntegrationHub.astro';
import GoLiveTimeline from '../components/illustrations/GoLiveTimeline.astro';
import IncidentLifecycle from '../components/illustrations/IncidentLifecycle.astro';
import { url } from '../lib/url';

interface Props { entry: CollectionEntry<'cases'>; headings: MarkdownHeading[] }
const { entry, headings } = Astro.props;
const d = entry.data;

// Find a section anchor by the start of its heading text, so illustrations can
// link into the Markdown body without hard-coding generated ids.
const h2s = headings.filter((h) => h.depth === 2);
const anchor = (prefix: string) => {
  const h = h2s.find((x) => x.text.toLowerCase().startsWith(prefix.toLowerCase()));
  return h ? `#${h.slug}` : undefined;
};
const wheelAnchors = Object.fromEntries(
  ['A', 'B', 'C', 'D', 'E', 'F'].map((k) => [k, anchor(`Workstream ${k}`)]),
);

// Captions for each named illustration (stat-counters renders without a frame).
const figures = d.illustrations.filter((n) => n !== 'stat-counters');
const meta = {
  'workstream-wheel': { title: 'Programme at a glance', caption: 'Six workstreams. Select one to jump to it.', link: undefined },
  'migration-lifecycle': { title: 'Data migration lifecycle', caption: 'Ten stages, from discovery to reconciliation.', link: anchor('Workstream C') },
  'integration-hub': { title: 'Integration landscape', caption: '18 submodules · 6+ internal · 6+ external · 180+ touchpoints.', link: anchor('Workstream C') },
  'golive-timeline': { title: 'Go-live readiness path', caption: 'Milestone-based deployment with a Go/No-Go gate.', link: anchor('Workstream F') },
  'incident-lifecycle': { title: 'Incident governance model', caption: 'Lifecycle phases under a single PMO governance layer.', link: anchor('Responsibilities') },
} as const;
---
<BaseLayout title={d.shortTitle ?? d.title} description={d.summary}>
  <article>
    <header class="section container head">
      <a href={url('/portfolio')} class="back">← All engagements</a>
      <div class="meta"><span>{d.sector}</span><span>{d.location}</span>{d.duration && <span>{d.duration}</span>}</div>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
      <div class="roles">
        <span class="muted">Role{d.roles.length > 1 ? 's' : ''}:</span>
        <ul class="tags">{d.roles.map((r) => <li class="tag">{r}</li>)}</ul>
      </div>
    </header>

    {d.illustrations.includes('stat-counters') && d.stats.length > 0 && (
      <section class="container"><StatCounters stats={d.stats} /></section>
    )}

    {figures.length > 0 && (
      <section class="container figs">
        {figures.map((name) => {
          const m = meta[name];
          return (
            <>
            <figure class:list={['figure card', { wide: name !== 'workstream-wheel' }]}>
              <h2 class="fig-title">{m.title}</h2>
              {name === 'workstream-wheel' && <WorkstreamWheel anchors={wheelAnchors} />}
              {name === 'migration-lifecycle' && <MigrationLifecycle />}
              {name === 'integration-hub' && <IntegrationHub />}
              {name === 'golive-timeline' && <GoLiveTimeline />}
              {name === 'incident-lifecycle' && <IncidentLifecycle />}
              <figcaption>
                <span>{m.caption}</span>
                {m.link && <a href={m.link}>Read the detail ↓</a>}
              </figcaption>
            </figure>
            {name === 'workstream-wheel' && d.services.length > 0 && (
              <aside class="figure card services">
                <h2 class="fig-title">Services delivered</h2>
                <ol>{d.services.map((s, i) => <li><span>{String.fromCharCode(65 + i)}</span>{s}</li>)}</ol>
              </aside>
            )}
            </>
          );
        })}
      </section>
    )}

    <section class="section container">
      <div class="prose"><slot /></div>
    </section>
  </article>
</BaseLayout>
<style>
  .head { padding-bottom: 28px; }
  .back { display: inline-block; margin-bottom: 20px; font-weight: 600; text-decoration: none; }
  .meta { display: flex; gap: 14px; flex-wrap: wrap; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; color: var(--ink-3); margin-bottom: 10px; }
  .roles { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 8px; font-size: 0.92rem; }
  .figs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 20px; }
  .figs .wide { grid-column: 1 / -1; }
  .fig-title { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-2); margin-bottom: 18px; font-family: var(--font-sans); font-weight: 700; }
  .services ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .services li { display: flex; gap: 12px; align-items: center; padding: 10px 12px; border-radius: 10px; background: var(--surface-2); font-weight: 500; }
  .services li span { flex: none; width: 30px; height: 30px; border-radius: 8px; display: grid; place-items: center; background: var(--accent); color: var(--accent-ink); font: 700 0.95rem var(--font-display); }
  @media (max-width: 820px) { .figs { grid-template-columns: 1fr; } }
</style>
