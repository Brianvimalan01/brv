---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMonogram from '../components/illustrations/HeroMonogram.astro';
import StatCounters from '../components/illustrations/StatCounters.astro';
import HobbyIllustration from '../components/illustrations/HobbyIllustration.astro';
import CaseCard from '../components/CaseCard.astro';
import { url } from '../lib/url';

const cases = (await getCollection('cases', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order);
const hobbies = (await getCollection('hobbies')).sort((a, b) => a.data.order - b.data.order);

const headline = [
  { value: '3+', label: 'Years in transformation consulting' },
  { value: '18', label: 'ERP submodules governed' },
  { value: '180+', label: 'Integration touchpoints planned' },
  { value: '5', label: 'Month cyber incident PMO' },
];
---
<BaseLayout>
  <section class="hero section">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">BRV · Transformation Excellence Analyst</span>
        <h1>Brianvimalan Francis</h1>
        <p class="lead">
          I bridge consulting, business analysis, and technical delivery — governing complex ERP
          and technology transformations from requirements to go-live across the public and private sectors.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href={url('/portfolio')}>View portfolio →</a>
          <a class="btn" href={url('/about')}>About me</a>
        </div>
      </div>
      <HeroMonogram />
    </div>
  </section>

  <section class="container">
    <StatCounters stats={headline} />
  </section>

  <section class="section container">
    <div class="head">
      <div>
        <span class="eyebrow">Consulting portfolio</span>
        <h2>Selected engagements</h2>
      </div>
      <a href={url('/portfolio')}>All cases →</a>
    </div>
    <div class="grid cases">{cases.map((c) => <CaseCard entry={c} />)}</div>
  </section>

  <section class="container">
    <div class="head">
      <div>
        <span class="eyebrow">Off the clock</span>
        <h2>Running, hiking &amp; futsal</h2>
      </div>
      <a href={url('/hobbies')}>More →</a>
    </div>
    <div class="grid hobbies">
      {hobbies.map((h) => (
        <a class="hobby card" href={url(`/hobbies#${h.id}`)}>
          <HobbyIllustration name={h.data.icon} />
          <strong>{h.data.title}</strong>
          <span class="muted">{h.data.tagline}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
<style>
  .hero-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 40px; align-items: center; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .head { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 24px; }
  .head a { font-weight: 600; white-space: nowrap; }
  .cases { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .hobbies { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .hobby { padding: 18px; display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--ink); transition: transform .15s ease; }
  .hobby:hover { transform: translateY(-2px); }
  .hobby strong { font: 600 1.15rem var(--font-display); margin-top: 8px; }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-grid > :global(svg) { max-width: 320px; }
  }
</style>
