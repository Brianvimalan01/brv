---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('src/content/pages/about.md is missing');
const { Content } = await render(about);
---
<BaseLayout title="About" description={about.data.lead}>
  <section class="section container intro">
    <div>
      <span class="eyebrow">{about.data.eyebrow}</span>
      <h1>{about.data.title}</h1>
      {about.data.lead && <p class="lead">{about.data.lead}</p>}
    </div>
    <img class="avatar" src={url('/images/profile.jpg')} alt="Portrait of Brianvimalan Francis" width="703" height="900" />
  </section>

  <section class="container prose-wrap">
    <div class="prose"><Content /></div>
    <p class="more"><a class="btn btn-primary" href={url('/portfolio')}>See my projects →</a></p>
  </section>
</BaseLayout>
<style>
  .intro { display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center; padding-bottom: 24px; }
  .avatar {
    width: clamp(140px, 20vw, 200px); aspect-ratio: 1; border-radius: 50%; object-fit: cover; object-position: top;
    box-shadow: 0 0 0 8px var(--accent-soft);
  }
  .more { margin-top: 28px; }
  @media (max-width: 640px) { .intro { grid-template-columns: 1fr; } .avatar { order: -1; } }
</style>
