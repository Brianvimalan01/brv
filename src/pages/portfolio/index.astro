---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';

const cases = (await getCollection('cases', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Projects">
  <section class="section container">
    <span class="eyebrow">Projects</span>
    <h1>Things I've worked on</h1>
    <p class="lead">
      ERP modernisation, project governance, data migration and cyber incident coordination.
      Pick a project to see what it involved. Client names and confidential details are left out.
    </p>
  </section>
  <section class="container grid cases">
    {cases.map((c) => <CaseCard entry={c} />)}
  </section>
</BaseLayout>
<style>
  .cases { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
</style>
